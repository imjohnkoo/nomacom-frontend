# Build outputs
.output
.data
.nuxt
.nitro
.cache
dist
.turbo
*.tsbuildinfo

# Dependencies
node_modules

# Yarn Berry (keep releases + patches + plugins, ignore runtime/cache)
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Claude — 개인 설정/런타임 상태만 ignore, 나머지 .claude/ 는 전부 추적
# (스킬·훅·rules 가 git 에 없으면 워크트리 간 전파도 이력도 없다 — 2026-09-02 전환)
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Internal documentation — 로컬 전용, EXCEPT 기획문서 (docs/specs/ 기능정의서 + docs/plans/ 코딩계획서 — git 공유)
# 부모 docs/ 를 통째로 ignore 하면 자식을 되살릴 수 없으므로 직접 자식만 ignore + 기획문서만 예외
/docs/*
!/docs/specs/
!/docs/plans/
# 앱/패키지 로컬 docs 는 여전히 금지 (실수로 생성돼도 무시)
apps/*/docs/
packages/*/docs/

# Storage
storage/
design/products/_generator/.golden-out/

# 썸네일 렌더 결과 (PNG 대량 · 재생성 가능)
design/thumbnails/out/
